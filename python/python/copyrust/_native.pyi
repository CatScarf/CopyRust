from collections.abc import Callable, Sequence
from os import PathLike
from typing import Literal

class CopyOptions:
    def __init__(
        self,
        *,
        compare: Literal["mtime", "hash", "auto", "always"] = "mtime",
        recursive: bool = True,
        preserve_mtime: bool = True,
        purge: bool = False,
        case_sensitive: bool | None = None,
        exclude_dirs: list[str] = ...,
        exclude_files: list[str] = ...,
        include_files: list[str] = ...,
    ) -> None: ...

class CopyJob:
    def __init__(
        self,
        source: str | PathLike[str],
        destination: str | PathLike[str],
        *,
        options: CopyOptions | None = None,
    ) -> None: ...
    @property
    def source(self) -> str: ...
    @property
    def destination(self) -> str: ...

class RunOptions:
    def __init__(
        self,
        *,
        scan_workers: int = 8,
        hash_workers: int = 4,
        copy_workers: int = 4,
        retries: int = 2,
        progress_interval_ms: int = 250,
        dry_run: bool = False,
    ) -> None: ...

class Progress:
    @property
    def phase(self) -> str: ...
    @property
    def elapsed_seconds(self) -> float: ...
    @property
    def scanned_files(self) -> int: ...
    @property
    def total_files(self) -> int | None: ...
    @property
    def compared_files(self) -> int: ...
    @property
    def hashed_bytes(self) -> int: ...
    @property
    def copied_files(self) -> int: ...
    @property
    def copied_bytes(self) -> int: ...
    @property
    def total_copy_bytes(self) -> int | None: ...
    @property
    def skipped_mtime(self) -> int: ...
    @property
    def skipped_hash(self) -> int: ...
    @property
    def skipped_same_file(self) -> int: ...
    @property
    def skipped_links(self) -> int: ...
    @property
    def deleted_files(self) -> int: ...
    @property
    def failed_files(self) -> int: ...
    @property
    def planned_copy_files(self) -> int: ...
    @property
    def planned_delete_files(self) -> int: ...
    @property
    def dry_run(self) -> bool: ...
    @property
    def complete(self) -> bool: ...
    def to_json(self) -> str: ...

class Summary:
    @property
    def success(self) -> bool: ...
    @property
    def progress(self) -> Progress: ...
    @property
    def errors(self) -> list[str]: ...
    def to_json(self) -> str: ...

def copy(
    jobs: Sequence[CopyJob],
    *,
    options: RunOptions | None = None,
    on_progress: Callable[[Progress], None] | None = None,
) -> Summary: ...
def run_cli(args: list[str]) -> int: ...
